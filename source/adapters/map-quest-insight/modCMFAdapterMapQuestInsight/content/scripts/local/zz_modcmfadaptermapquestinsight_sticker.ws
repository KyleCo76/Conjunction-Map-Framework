// Map Quest Insight's Sticker icons on CMF's map (adapter 2.0.0). Map Quest Insight 2.0 draws its Sticker
// icons for the game's own markers in its own map file, while its Map icon style ([qmiOther] qmiIconStyle) is
// Sticker, its default. CMF's map shows the same pictures through icon claims: Wolfer, Map Quest Insight's
// author, sent them as PNGs for this adapter, to be shown only while that setting is Sticker (2026-10-25). The
// pictures come from art-src/mqi_icons.py, which also writes the table below. Quest pins keep the quest icons
// of zz_modcmfadaptermapquestinsight_cmf.ws: a claim on one pin beats a claim on its type.
//
// The claims are sent when the setting turns to Sticker and withdrawn (property 40, API 13) when it turns to
// Vanilla, both before the map builds its pins, so a change shows the next time the map opens. This wrapper
// reads only the setting, so its place among the adapter's other wrappers does not matter.

@addField(CR4Game)
var mqiAdapterStickerOn : bool;

@addMethod(CR4Game)
function MqiAdapterSetStickerOn(on : bool)
{
	mqiAdapterStickerOn = on;
}

@wrapMethod(CR4MapMenu)
function OnConfigUI()
{
	var on : bool;
	on = MqiAdapterStickerWanted();
	if (on != theGame.mqiAdapterStickerOn && CMFHasProperty(40))
	{
		MqiAdapterStickers(on);
		theGame.MqiAdapterSetStickerOn(on);
	}
	return wrappedMethod();
}

// Sticker unless the player chose Vanilla (0). A value never saved means Map Quest Insight's own default, Sticker.
function MqiAdapterStickerWanted() : bool
{
	var style : string;
	style = StrLower(theGame.GetInGameConfigWrapper().GetVarValue('qmiOther', 'qmiIconStyle'));
	return style != "0" && style != "false";
}

function MqiAdapterSticker(on : bool, pinType : name, file : string)
{
	if (on)
	{
		CMFRegisterIcon("modMapQuestInsight", pinType, "img://icons/modcmfadaptermapquestinsight/" + file);
	}
	else
	{
		CMFRegister("modMapQuestInsight", 40, pinType, '', "", CMFPropertyIcon());
	}
}

// One claim per game pin type Wolfer's index.tsv names (the four pictures with no game type of their own, banker,
// cartographer, gwent_player and waypoint, are left out).
function MqiAdapterStickers(on : bool)
